---
/*  Every page: header, content, footer. `identity` is a plugin's own colour, worn on the header's
    and the footer's rules as the plugin wears it; the other pages rule in ink. `wide` gives a tool's
    page the wider measure, header and footer included. */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  identity?: string;
  wide?: boolean;
}
const { title, description = 'bambi, a free and open-source ambisonics plugin suite.', identity, wide } = Astro.props;
const style = [identity && `--identity: ${identity}`, wide && '--page: var(--page-wide)'].filter(Boolean).join('; ');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title ? `${title} · bambi` : 'bambi'}</title>
  </head>
  <body style={style || undefined}>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-top: var(--section);
  }
</style>
