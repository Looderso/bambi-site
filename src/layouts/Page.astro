---
/*  Every page: header, content, footer. `identity` is a plugin's own colour, worn on the header's
    and the footer's rules as the plugin wears it; the other pages rule in ink. `wide` gives a page the
    wider measure; the header and footer span the window whatever the measure. */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NextScreen from '../components/NextScreen.astro';

interface Props {
  title?: string;
  description?: string;
  identity?: string;
  wide?: boolean;
}
const { title, description = 'bambi, a free and open-source ambisonics plugin suite.', identity, wide } = Astro.props;
const style = [identity && `--identity: ${identity}`, wide && '--page: var(--page-wide)'].filter(Boolean).join('; ');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title ? `${title} · bambi` : 'bambi'}</title>
  </head>
  <body style={style || undefined}>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <NextScreen />
    <script>
      /*  Every code block in prose gets a copy button. */
      for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
        const button = document.createElement('button');
        button.className = 'copy';
        button.type = 'button';
        button.textContent = 'copy';
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
          button.textContent = 'copied';
          setTimeout(() => (button.textContent = 'copy'), 1500);
        });
        pre.append(button);
      }
    </script>
  </body>
</html>

<style>
  /*  The content takes the room the page has left, full width, its measure set by `.wrap`. */
  main {
    flex: 1 0 auto;
    width: 100%;
    padding-top: var(--section);
  }
</style>
