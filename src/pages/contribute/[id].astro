---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PrevNext from '../../components/PrevNext.astro';

export async function getStaticPaths() {
  const guidelines = (await getCollection('guidelines')).sort((a, b) => a.data.order - b.data.order);
  //  each one's neighbours in reading order: working on bambi, then how it is designed
  return guidelines.map((guideline, i) => ({
    params: { id: guideline.id },
    props: { guideline, previous: guidelines[i - 1], next: guidelines[i + 1] },
  }));
}

const { guideline, previous, next } = Astro.props;
const { Content } = await render(guideline);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (g?: typeof guideline) => g && { href: `${base}/contribute/${g.id}`, title: g.data.title };
---

<Page title={guideline.data.title} description={guideline.data.summary}>
  <p class="label"><a href={`${base}/contribute`}>contribute</a></p>
  <h1>{guideline.data.title}</h1>
  <p class="lede summary">{guideline.data.summary}</p>
  <div class="prose">
    <Content />
  </div>
  <PrevNext previous={link(previous)} next={link(next)} />
</Page>

<style>
  h1 {
    margin: 8px 0 16px;
  }
  .summary {
    margin-bottom: var(--section);
  }
</style>
