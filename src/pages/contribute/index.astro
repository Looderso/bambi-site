---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Cards from '../../components/Cards.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guidelines = (await getCollection('guidelines')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'working', title: 'working on bambi' },
  { id: 'design', title: 'how bambi is designed' },
].map((group) => ({
  ...group,
  items: guidelines
    .filter((g) => g.data.group === group.id)
    .map((g) => ({ href: `${base}/contribute/${g.id}`, title: g.data.title, text: g.data.summary })),
}));
---

<Page title="contribute" description="How to build bambi, the rules its code is written by, and how it is designed.">
  <h1>contribute</h1>
  <p class="sub label">how to build bambi, the rules its code is written by, and the guidelines a change is held to</p>

  <div class="prose intro">
    <p>
      bambi is free and open source, and <a href="https://github.com/Looderso/bambi">its code is on GitHub</a>.
      The first list is how to work on it: how to build and check a change, and the rules the code is written by.
      The second is how bambi is designed, one concept to a page, so a change fits what is already there. Each
      page leads to the next, so either list can be read in order.
    </p>
  </div>

  {
    groups.map((group) => (
      <section>
        <h2>{group.title}</h2>
        <Cards items={group.items} style="row" />
      </section>
    ))
  }
</Page>

<style>
  .sub {
    margin: 12px 0 var(--section);
  }
  .intro {
    margin-bottom: var(--section);
  }
  section {
    margin-bottom: var(--section);
  }
</style>
