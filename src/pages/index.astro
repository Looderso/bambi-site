---
import Page from '../layouts/Page.astro';
import PluginList from '../components/PluginList.astro';
---

<Page>
  <section class="intro">
    <p class="label">an ambisonics plugin suite</p>
    <h1 class="lede">An encoder that moves sound along paths you draw, an echo whose repeats turn through the field, and a reverb that puts the whole field in a room.</h1>
    <p class="meta label">vst3 · clap · free and open source</p>
  </section>

  <section>
    <h2>the plugins</h2>
    <PluginList />
  </section>
</Page>

<style>
  .intro {
    display: grid;
    gap: 16px;
    margin-bottom: var(--section);
  }
  .intro h1 {
    font-size: var(--size-title);
    max-width: 22ch;
  }
  .intro p {
    margin: 0;
  }
</style>
