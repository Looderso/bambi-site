---
/*  The front page says what bambi is for and where to go next. The plugins themselves are on their
    own page; this one points there rather than repeating it. */
import Page from '../layouts/Page.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ideas = [
  {
    title: 'driven by the signal',
    text: 'Level, attack, tonality and three bands of the input, measured with no lookahead, drive any parameter through one modulation matrix, beside LFOs and envelopes.',
  },
  {
    title: 'interpretable',
    text: 'The sphere shows what arrives and what the plugin adds, and a probe shows what it would do to any direction. Every value is set, modulated and read in the same box.',
  },
  {
    title: 'one system',
    text: 'Every plugin shares the window, the matrix, regions, presets and undo, and every instance in a project can be edited from any window.',
  },
];

const next = [
  { href: '/download', name: 'download', text: 'VST3 and CLAP for macOS, Windows and Linux. Free, and in alpha.' },
  { href: '/tutorial', name: 'tutorial', text: 'The parts of the window, and what each is for.' },
  { href: '/plugins', name: 'plugins', text: 'What each plugin does.' },
  { href: '/contribute', name: 'contribute', text: 'How to build bambi, and the rules its code is written by.' },
];
---

<Page>
  <section class="intro">
    <p class="label">an ambisonics plugin suite</p>
    <h1>Intuitive yet powerful spatialization.</h1>
    <p class="meta label">ambix at any order · vst3 · clap · free and open source</p>
  </section>

  <figure class="window">
    <img src={`${base}/tutorial/window.webp`} alt="A bambi window: the sphere with the sound's energy on it, the modulation matrix, and the plugin's controls." width="2040" height="1200" />
  </figure>

  <section class="ideas">
    {
      ideas.map((idea) => (
        <div>
          <h2>{idea.title}</h2>
          <p>{idea.text}</p>
        </div>
      ))
    }
  </section>

  <section>
    <h2>where to go</h2>
    <ul class="next">
      {
        next.map((n) => (
          <li>
            <a href={`${base}${n.href}`}>{n.name}</a>
            <span>{n.text}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Page>

<style>
  .intro {
    display: grid;
    gap: 16px;
    margin-bottom: var(--section);
  }
  .intro h1 {
    max-width: 22ch;
  }
  .intro p {
    margin: 0;
  }
  .window {
    margin: 0 0 var(--section);
  }
  .window img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--stroke-rule) solid var(--rule);
  }
  .ideas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap);
    margin-bottom: var(--section);
  }
  .ideas p {
    margin: 0;
  }
  .next {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .next li {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--gap);
    padding: 12px 0;
    border-bottom: var(--stroke-rule) solid var(--sand-light);
  }
  .next span {
    color: var(--label);
  }
  @media (max-width: 600px) {
    .next li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
