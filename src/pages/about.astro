---
/*  About: what bambi is, the people it thanks, its licence and its notices. The research and software it builds
    on are credited on foundations, not here. */
import Page from '../layouts/Page.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const thanks = ['Daniel Rudrich', 'Alexander Mülleder', 'Fabian Hummel', 'Jonathan Wögerbauer'];
---

<Page title="about" description="What bambi is, who it thanks, and its licence.">
  <h1>about</h1>
  <p class="sub label">free and open source</p>

  <section>
    <h2>what bambi is</h2>
    <div class="prose">
      <p>
        bambi is a suite of ambisonics plugins, and a host that plays a Live set through them. The plugins share one
        window, one modulation matrix and a link between instances, so what you learn in one works in the others.
        They work in AmbiX (ACN ordering, SN3D normalisation), at any order the host carries.
      </p>
    </div>
  </section>

  <section>
    <h2>special thanks</h2>
    <div class="prose">
      <p>For inspiration and ideas, to</p>
    </div>
    <ul class="names">{thanks.map((name) => <li>{name}</li>)}</ul>
    <p class="fine">The research and the software bambi builds on are credited on <a href={`${base}/research/foundations`}>foundations</a>.</p>
  </section>

  <section>
    <h2>licence</h2>
    <div class="prose">
      <p>
        bambi’s own code is GPL-3.0-or-later; the plugin builds, which include JUCE, are distributed under AGPLv3.
        The source is on <a href="https://github.com/Looderso/bambi">GitHub</a>, and every release carries its
        complete source and the notices of the third-party components it contains.
      </p>
    </div>
  </section>

  <p class="fine notices">VST is a registered trademark of Steinberg Media Technologies GmbH.</p>
</Page>

<style>
  .sub {
    margin: 12px 0 var(--section);
  }
  section + section,
  .notices {
    margin-top: var(--section);
  }
  /*  The names, one to a row on the rule, as the site lists what deserves weight. */
  .names {
    list-style: none;
    margin: 8px 0 16px;
    padding: 0;
    max-width: var(--measure);
    border-top: var(--stroke-rule) solid var(--rule-strong);
  }
  .names li {
    padding: 12px 0;
    font-size: var(--size-lede);
    border-bottom: var(--stroke-rule) solid var(--rule);
  }
</style>
