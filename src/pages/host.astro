---
/*  The host's page: a product page like a plugin's, its own window held beside the text, one screen per part.
    The host's window is wider than a plugin's, 1092 x 600 points, and its pictures are drawn by its picture
    tool (scripts/pictures.sh). */
import Page from '../layouts/Page.astro';
import ProductPage, { type Part } from '../components/ProductPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const summary = 'Runs bambi’s ambisonic plugins beside Ableton Live.';
//  why there is a host at all, under the title: a visitor knows plugins, not why they need one
const why =
  'Live’s tracks are stereo: no track or bus carries more than two channels. Ambisonics needs four channels at first order and sixteen at third, so bambi’s plugins cannot run inside Live. The host runs them beside Live instead, on an ambisonics bus. Each track leaves Live through bambi’s virtual audio driver and plays through bambi’s plugins in the host. Live keeps the arrangement, the transport, your faders and sends.';

const parts: Part[] = [
  {
    shot: 'routing',
    crop: [0, 44, 72, 556],
    label: 'sidebar',
    title: 'the plugins and the host’s pages',
    text: 'On the left: each plugin’s window, then the host’s routing, timeline and audio settings. At the bottom: whether Live is connected, how many sources are playing, and the latency.',
  },
  {
    shot: 'routing',
    crop: [76, 52, 380, 310],
    label: 'routing · live’s tracks',
    title: 'Live’s tracks and groups',
    text: 'Live’s tracks and groups in one column, the host’s own inputs below. Each track stays in Live, or goes into bambi through an encoder, with insert effects after it.',
    points: ['<b>+ encoder</b> · encodes a track into the ambisonics bus', '<b>+</b> · adds an insert effect after the encoder'],
  },
  {
    shot: 'routing',
    crop: [510, 52, 320, 145],
    label: 'routing · returns and main',
    title: 'returns and main',
    text: 'Live’s returns and main, each kept in Live or taken into bambi with its own insert effects, such as a reverb on a return.',
  },
  {
    shot: 'wires',
    crop: [76, 52, 760, 270],
    label: 'routing · sends',
    title: 'sends',
    text: 'Press send, and the destinations a track can reach light up; click one to add a send at 0 dB. Click a track’s name to show its sends below it, and drag one to set its level.',
    points: ['<b>route all</b> · every track into bambi at once', '<b>all to Live</b> · every track back to Live'],
  },
  {
    shot: 'routing',
    crop: [880, 52, 212, 180],
    label: 'routing · decoders',
    title: 'any number of decoders',
    text: 'Each decoder gets its own mix and plays to headphones, loudspeakers, or both.',
  },
  {
    shot: 'timeline',
    crop: [70, 40, 800, 400],
    label: 'timeline',
    title: 'arrangement and automation',
    text: 'Live’s transport and arrangement, in sync. Under each track, automation lanes for any plugin parameter in the host, following Live’s song position.',
  },
  {
    shot: 'session',
    crop: [70, 40, 800, 520],
    label: 'timeline · session',
    title: 'session clips with their own automation',
    text: 'Live’s session view. Choose a clip, and its automation lanes open at the bottom, following the clip as it loops.',
  },
  {
    shot: 'outputs',
    crop: [105, 22, 880, 530],
    label: 'audio',
    title: 'outputs',
    text: 'The audio settings: the audio interfaces, then every output — Live’s main, each decoder’s headphones and loudspeakers on their channels — with copies to other channels, or back into Live for recording.',
  },
];

const tutorials = [{ href: `${base}/tutorial/host`, title: 'the host', text: 'Setting up Ableton Live to play through bambi.', kind: 'the host' }];
---

<Page title="host" description={summary} wide>
  <ProductPage
    name="host"
    mark={`${base}/marks/host.svg`}
    summary={summary}
    about={why}
    shots={`${base}/product/host`}
    window={[1092, 600]}
    parts={parts}
    tutorials={tutorials}
  >
    <div class="prose after">
      <h2>where it runs</h2>
      <p>
        The host runs on macOS and works with Ableton Live: Live plays into it, and Live keeps the arrangement and the
        transport. Other DAWs, and other systems, are open: say on <a href="https://github.com/Looderso/bambi/issues">GitHub</a>
        which one you work in. What has been tried where is on <a href={`${base}/status`}>status</a>.
      </p>
    </div>
  </ProductPage>
</Page>

<style>
  .after {
    margin-top: var(--section);
    border-top: var(--stroke-rule) solid var(--rule-strong);
    padding-top: 24px;
  }
</style>
