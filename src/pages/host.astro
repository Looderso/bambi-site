---
/*  The host's page: a product page like a plugin's, its own window held beside the text, one screen per part.
    The host's window is wider than a plugin's, 1092 x 600 points, and its pictures are drawn by its picture
    tool (scripts/pictures.sh). */
import Page from '../layouts/Page.astro';
import ProductPage, { type Part } from '../components/ProductPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const summary = 'A Live set’s tracks, played as a field through bambi.';

const parts: Part[] = [
  {
    shot: 'routing',
    crop: [0, 44, 72, 556],
    label: 'the rail',
    title: 'the suite, and the host’s own pages',
    text: 'Down the left edge: each plugin’s own window, then the host’s routing, its timeline, and the audio sheet. At the foot, whether Live is connected, how many sources play, and the latency.',
  },
  {
    shot: 'routing',
    crop: [76, 52, 380, 310],
    label: 'routing · live’s tracks',
    title: 'every track, as Live files it',
    text: 'Live’s tracks and groups in a column, and the host’s own inputs under them. Each track is left in Live, or played by bambi: through an encoder, with inserts after it.',
    points: ['<b>+ encoder</b> · takes a track into bambi', '<b>+</b> · an insert after its encoder'],
  },
  {
    shot: 'routing',
    crop: [510, 52, 320, 145],
    label: 'routing · returns and main',
    title: 'returns and main, in the field',
    text: 'Live’s returns and its main, each left in Live or taken into bambi with inserts of its own, as a reverb on a return.',
  },
  {
    shot: 'wires',
    crop: [76, 52, 760, 270],
    label: 'routing · wires',
    title: 'sends along wires',
    text: 'Press send, and what a track may reach rings; a click there makes the wire, at 0 dB. Choose a track by its name, and its wires open under it, dragged for their level.',
    points: ['<b>route all</b> · every track into the field at once', '<b>all to Live</b> · every track back'],
  },
  {
    shot: 'routing',
    crop: [880, 52, 212, 180],
    label: 'routing · decoders',
    title: 'any number of decoders',
    text: 'Each decoder hears a mix of its own, and plays to headphones, to loudspeakers, or to both.',
  },
  {
    shot: 'timeline',
    crop: [70, 40, 800, 400],
    label: 'timeline',
    title: 'the arrangement, with lanes over it',
    text: 'Live’s transport and arrangement, drawn as heard. Under each track, lanes for any parameter the host plays, set every block from the song position the plugins hear.',
  },
  {
    shot: 'session',
    crop: [70, 40, 800, 520],
    label: 'timeline · session',
    title: 'clips, with lanes of their own',
    text: 'Live’s session grid. Choose a clip, and its own lanes open at the foot, following the clip as it loops.',
  },
  {
    shot: 'outputs',
    crop: [105, 22, 880, 530],
    label: 'audio',
    title: 'where everything goes out',
    text: 'The audio sheet: the interfaces, then every output — Live’s main, each decoder’s headphones and speakers, on their channels — with copies on other channels, or back to Live for recording.',
  },
];

const tutorials = [{ href: `${base}/tutorial/host`, title: 'the host', text: 'Setting up a set to play through bambi.', kind: 'the host' }];
---

<Page title="host" description={summary} wide>
  <ProductPage
    name="host"
    mark={`${base}/marks/host.svg`}
    summary={summary}
    shots={`${base}/product/host`}
    window={[1092, 600]}
    parts={parts}
    tutorials={tutorials}
  >
    <div class="prose after">
      <h2>where it runs</h2>
      <p>
        The host runs on macOS and works with Ableton Live: Live plays into it, and Live keeps the arrangement and the
        transport. Other DAWs, and other systems, are open: say on <a href="https://github.com/Looderso/bambi/issues">GitHub</a>
        which one you work in. What has been tried where is on <a href={`${base}/status`}>status</a>.
      </p>
    </div>
  </ProductPage>
</Page>

<style>
  .after {
    margin-top: var(--section);
    border-top: var(--stroke-rule) solid var(--rule-strong);
    padding-top: 24px;
  }
</style>
