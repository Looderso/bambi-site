---
/*  Every tutorial in src/lib/tutorials.ts without a page of its own: its title, what it covers, and its outline
    until the text exists. A tutorial for one plugin wears that plugin's colour. */
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PrevNext from '../../components/PrevNext.astro';
import Outline from '../../components/Outline.astro';
import { neighbours, tutorials } from '../../lib/tutorials';

export function getStaticPaths() {
  const own = Object.keys(import.meta.glob('./*.astro')).map((f) => f.slice(2, -6));
  return tutorials.filter((t) => !own.includes(t.id)).map((t) => ({ params: { id: t.id }, props: { tutorial: t } }));
}

const { tutorial } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const identity = (await getCollection('plugins')).find((p) => p.id === tutorial.plugin)?.data.colour;
const { previous, next } = neighbours(tutorial.id);
const link = (t?: { id: string; title: string }) => t && { href: `${base}/tutorial/${t.id}`, title: t.title };
---

<Page title={tutorial.title} description={tutorial.summary} identity={identity}>
  <h1>{tutorial.title}</h1>
  <p class="sub label">{tutorial.summary.toLowerCase().replace(/\.$/, '')}</p>
  <p class="fine">
    This tutorial is being written.
    {tutorial.plugin && <>It covers only what {tutorial.title} adds to <a href={`${base}/tutorial/the-window`}>the window</a> every plugin shares.</>}
  </p>
  {tutorial.outline && <Outline parts={tutorial.outline} />}
  <PrevNext previous={link(previous)} next={link(next)} />
</Page>

<style>
  .sub {
    margin: 12px 0 16px;
  }
</style>
