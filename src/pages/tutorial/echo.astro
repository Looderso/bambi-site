---
/*  How to use echo, step by step, with pictures drawn by its picture tool. An outline until the text exists. */
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PrevNext from '../../components/PrevNext.astro';
import { neighbours, tutorials } from '../../lib/tutorials';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tutorial = tutorials.find((t) => t.id === 'echo')!;
const identity = (await getCollection('plugins')).find((p) => p.id === tutorial.plugin)?.data.colour;
const { previous, next } = neighbours('echo');
const parts = [
  ['taps', 'the taps', 'The row of starting points, the strip of four taps, and choosing one.'],
  ['timing', 'timing', 'Free or synced, the offset and swing.'],
  ['axis', 'axis', 'The direction a tap turns about.'],
  ['every-pass', 'every pass', 'Spin, skew, feedback, blur, and the low and high cut.'],
  ['send', 'send', 'The region the taps hear.'],
  ['scene', 'the taps on the sphere', "Each tap's passes drawn where they land."],
];
const link = (t?: { id: string; title: string }) => t && { href: `${base}/tutorial/${t.id}`, title: t.title };
---

<Page title={tutorial.title} description={tutorial.summary} identity={identity}>
  <p class="label"><a href={`${base}/tutorial`}>tutorial</a></p>
  <h1>{tutorial.title}</h1>
  <p class="sub label">{tutorial.summary.toLowerCase().replace(/\.$/, '')}</p>
  <p class="fine">
    This tutorial is being written. It covers only what is Echo's own; the window every plugin shares is in
    <a href={`${base}/tutorial/the-window`}>the window</a>.
  </p>

  {
    parts.map(([id, title, text]) => (
      <section id={id}>
        <h2>{title}</h2>
        <p class="fine">{text}</p>
      </section>
    ))
  }

  <PrevNext previous={link(previous)} next={link(next)} />
</Page>

<style>
  .sub {
    margin: 12px 0 16px;
  }
  section {
    margin-top: 40px;
  }
</style>
