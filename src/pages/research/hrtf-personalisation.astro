---
/*  The personalisation model, written up as a short paper: what it is, the data, how the parts are made, and
    the figures. Figures are inline SVG in currentColor, drawn from the model's own files. The sections are
    outlines until the text and the figures exist. */
import Page from '../../layouts/Page.astro';
import Outline from '../../components/Outline.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  ['abstract', 'abstract', 'What the model is, in one paragraph.'],
  ['data', 'the data', 'The databases, the heads in each, and how they were made symmetric.'],
  ['nobodys-head', "nobody's head", 'The mean of every part but the notches, and why its timbre is the KU100’s.'],
  ['ear-slider', 'the ear slider', 'The notch template, learned from half of the people, shifted along frequency.'],
  ['head-slider', 'the head slider', 'The interaural time difference scaled, and the low level difference with it.'],
  ['listening', 'listening', 'How the sliders are found by ear, and what the listening rounds show.'],
  ['references', 'references', 'The databases and the papers the model rests on.'],
];
---

<Page title="a head made, not chosen" description="Personal binaural from the average of measured heads and two sliders.">
  <p class="label"><a href={`${base}/research`}>research</a></p>
  <h1>a head made, not chosen</h1>
  <p class="sub label">personal binaural from the average of measured heads, an ear slider and a head slider</p>
  <p class="fine">This page is being written.</p>

  <Outline parts={sections.map(([id, title, text]) => ({ id, title, text }))} />
</Page>

<style>
  .sub {
    margin: 12px 0 16px;
  }
</style>
