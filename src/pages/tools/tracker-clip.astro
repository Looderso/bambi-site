---
/*  The tracker clip: a grip for the head tracker, a grip for the headphones, a printable STL out. Both
    grips come from one library and are chosen from presets, then edited. Everything runs in the visitor's
    browser; the model is in src/lib/clip. */
import Page from '../../layouts/Page.astro';
import { kinds, presetsFor } from '../../lib/clip/grips';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ends = [
  { id: 'tracker', title: 'tracker' },
  { id: 'headphones', title: 'headphones' },
] as const;
const printHints = {
  tolerance: 'clearance on every fitting surface; raise it if parts are too tight',
  wall: 'thicker is stiffer, thinner snaps on more easily',
  reach: 'between the two grips',
};
---

<Page title="tracker clip" description="A printable clip that holds a head tracker on your headphones." wide>
  <div class="tool">
    <div class="look">
      <p class="label"><a href={`${base}/tools`}>tools</a></p>
      <h1>tracker clip</h1>
      <p class="lede summary">A clip that holds a head tracker on the headphones you listen on, an AirPod included.</p>
      <div class="preview" data-preview>
        <p class="label status" data-status>loading the model…</p>
      </div>
    </div>

    <form class="form" data-form>
      <div class="ends">
        {
          ends.map((end) => (
            <section data-end={end.id}>
              <h2>{end.title}</h2>
              <label class="device">
                <span class="label">device</span>
                {presetsFor(end.id).length > 0 ? (
                  <select name={`${end.id}.device`} data-device>
                    <option value="">custom</option>
                    {presetsFor(end.id).map((p) => (
                      <option value={p.id}>{p.name}</option>
                    ))}
                  </select>
                ) : (
                  <select name={`${end.id}.device`} data-device disabled>
                    <option value="">presets coming soon</option>
                  </select>
                )}
              </label>
              <div class="segments">
                {kinds.map((k) => (
                  <button type="button" data-kind-choice={k.id}>
                    {k.name}
                  </button>
                ))}
              </div>
              {kinds.map((k) => (
                <div class="kind" data-kind={k.id} hidden>
                  <figure class="figure" set:html={k.figure} />
                  <div class="values">
                    {k.measures.map((m) => (
                      <label class="value">
                        <span class="label">{m.label}</span>
                        <span class="field">
                          <input type="number" inputmode="decimal" name={`${end.id}.${m.key}`} min={m.min} max={m.max} step={m.step} data-hint={m.hint} title={m.hint} />
                          <span class="unit">{m.unit}</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
              <p class="hint" data-hint-line />
              <button type="button" class="button" data-export={end.id}>
                {end.id === 'tracker' ? 'tracker grip' : 'headphone grip'} · stl
              </button>
            </section>
          ))
        }
      </div>

      <section>
        <h2>print</h2>
        <div class="values three">
          <label class="value">
            <span class="label">tolerance</span>
            <span class="field"><input type="number" inputmode="decimal" name="tolerance" min="0" max="0.8" step="0.05" data-hint={printHints.tolerance} title={printHints.tolerance} /><span class="unit">mm</span></span>
          </label>
          <label class="value">
            <span class="label">wall</span>
            <span class="field"><input type="number" inputmode="decimal" name="wall" min="0.8" max="4" step="0.1" data-hint={printHints.wall} title={printHints.wall} /><span class="unit">mm</span></span>
          </label>
          <label class="value">
            <span class="label">gap</span>
            <span class="field"><input type="number" inputmode="decimal" name="reach" min="1" max="30" step="0.5" data-hint={printHints.reach} title={printHints.reach} /><span class="unit">mm</span></span>
          </label>
        </div>
        <p class="hint" data-hint-line />
      </section>

      <section class="export">
        <button type="button" class="button main" data-export="clip">export clip · stl</button>
        <p class="hint">
          Print flat as exported, with no supports; check a fit with one end's grip first. The file's name and the page's
          address keep the settings. Models are <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, with
          credit to bambi.wiki.
        </p>
      </section>
    </form>
  </div>
</Page>

<script>
  import Module from 'manifold-3d/manifold.js';
  import wasmUrl from 'manifold-3d/manifold.wasm?url';
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { kindOf, kinds, presets, presetsFor } from '../../lib/clip/grips';
  import { airpodGhost, clip, headphoneGrip, trackerGrip, type ClipSettings } from '../../lib/clip/build';
  import { binaryStl } from '../../lib/clip/stl';
  import type { End, Geometry } from '../../lib/clip/types';

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const params = new URLSearchParams(location.search);
  const endsOf: End[] = ['tracker', 'headphones'];

  //  each end: the device it was set from ('' once edited), the primitive, and its values; the address keeps all of it
  type EndState = { preset: string; kind: string; values: Record<string, number> };
  const startsAt: Record<End, EndState> = {
    tracker: { preset: 'airpods-pro-3', kind: 'oval', values: { ...presets.find((p) => p.id === 'airpods-pro-3')!.values } },
    headphones: { preset: '', kind: 'band', values: { ...kindOf('band').defaults } },
  };
  const fromAddress = (end: End): EndState => {
    if (!params.has(`${end}.kind`)) return startsAt[end];
    const kind = kinds.some((k) => k.id === params.get(`${end}.kind`)) ? params.get(`${end}.kind`)! : startsAt[end].kind;
    const preset = presetsFor(end).find((p) => p.id === params.get(`${end}.preset`) && p.kind === kind);
    const values: Record<string, number> = { ...(preset?.values ?? kindOf(kind).defaults) };
    for (const m of kindOf(kind).measures) {
      const n = Number(params.get(`${end}.${m.key}`));
      if (params.has(`${end}.${m.key}`) && Number.isFinite(n)) values[m.key] = n;
    }
    return { preset: preset?.id ?? '', kind, values };
  };
  const state = {
    tracker: fromAddress('tracker'),
    headphones: fromAddress('headphones'),
    tolerance: Number(params.get('tolerance') ?? 0.2),
    wall: Number(params.get('wall') ?? 1.6),
    reach: Number(params.get('reach') ?? 4),
  };

  const settings = (): ClipSettings => ({
    tracker: { kind: state.tracker.kind, values: state.tracker.values },
    headphones: { kind: state.headphones.kind, values: state.headphones.values },
    fit: { tolerance: state.tolerance, wall: state.wall },
    reach: state.reach,
  });

  function remember() {
    const q = new URLSearchParams();
    for (const end of endsOf) {
      if (state[end].preset) q.set(`${end}.preset`, state[end].preset);
      q.set(`${end}.kind`, state[end].kind);
      for (const [k, v] of Object.entries(state[end].values)) q.set(`${end}.${k}`, String(v));
    }
    for (const key of ['tolerance', 'wall', 'reach'] as const) q.set(key, String(state[key]));
    history.replaceState(null, '', `${location.pathname}?${q}`);
  }

  function showForm() {
    for (const end of endsOf) {
      const section = form.querySelector<HTMLElement>(`[data-end="${end}"]`)!;
      section.querySelector<HTMLSelectElement>('[data-device]')!.value = state[end].preset;
      for (const b of section.querySelectorAll<HTMLButtonElement>('[data-kind-choice]')) b.classList.toggle('chosen', b.dataset.kindChoice === state[end].kind);
      for (const k of section.querySelectorAll<HTMLElement>('[data-kind]')) {
        const shown = k.dataset.kind === state[end].kind;
        k.hidden = !shown;
        if (!shown) continue;
        for (const m of kindOf(state[end].kind).measures) {
          const input = k.querySelector<HTMLInputElement>(`input[name="${end}.${m.key}"]`);
          if (input) input.value = String(state[end].values[m.key]);
        }
      }
    }
    for (const key of ['tolerance', 'wall', 'reach'] as const) form.querySelector<HTMLInputElement>(`input[name="${key}"]`)!.value = String(state[key]);
  }

  //  the preview: z is up, as on the print bed
  const holder = document.querySelector<HTMLElement>('[data-preview]')!;
  const css = getComputedStyle(document.documentElement);
  const colour = (name: string) => new THREE.Color(css.getPropertyValue(name).trim());
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  holder.prepend(renderer.domElement);
  const scene = new THREE.Scene();
  scene.background = colour('--panel');
  const camera = new THREE.PerspectiveCamera(35, 1, 1, 2000);
  camera.up.set(0, 0, 1);
  camera.position.set(70, -90, 60);
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  scene.add(new THREE.HemisphereLight(0xffffff, 0x888888, 2.2));
  const sun = new THREE.DirectionalLight(0xffffff, 1.6);
  sun.position.set(40, -60, 100);
  scene.add(sun);
  const bed = new THREE.GridHelper(120, 24, colour('--grey-mid'), colour('--grey-light'));
  bed.rotation.x = Math.PI / 2;
  scene.add(bed);
  const clipMaterial = new THREE.MeshStandardMaterial({ color: colour('--grey-dark'), roughness: 0.7, flatShading: true });
  const ghostMaterial = new THREE.MeshStandardMaterial({ color: colour('--off-white'), roughness: 0.4, transparent: true, opacity: 0.45 });
  let shown: THREE.Mesh[] = [];

  function resize() {
    const w = holder.clientWidth;
    //  as tall as the screen leaves below the title, and no taller than it is wide
    const below = window.innerHeight - (holder.getBoundingClientRect().top + window.scrollY) - 24;
    const h = Math.round(Math.max(320, Math.min(w, below)));
    //  the drawing buffer only: the canvas's width is its column's, so it can shrink with it
    renderer.setSize(w, h, false);
    renderer.domElement.style.height = `${h}px`;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(holder);
  window.addEventListener('resize', resize);
  renderer.setAnimationLoop(() => {
    controls.update();
    renderer.render(scene, camera);
  });

  function meshOf(solid: any, material: THREE.Material) {
    const m = solid.getMesh();
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(m.triVerts.length * 3);
    for (let i = 0; i < m.triVerts.length; ++i)
      for (let k = 0; k < 3; ++k) positions[3 * i + k] = m.vertProperties[m.triVerts[i] * m.numProp + k];
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.computeVertexNormals();
    return new THREE.Mesh(geometry, material);
  }

  let g: Geometry;
  let framed = false;

  /** Points the camera at what is shown, from where it looks now, near enough to fill the view. */
  function frame() {
    const box = new THREE.Box3();
    for (const m of shown) box.expandByObject(m);
    const sphere = box.getBoundingSphere(new THREE.Sphere());
    const away = camera.position.clone().sub(controls.target).normalize();
    const distance = (sphere.radius / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2))) * 1.1;
    controls.target.copy(sphere.center);
    camera.position.copy(sphere.center).addScaledVector(away, distance);
    framed = true;
  }

  function rebuild() {
    for (const m of shown) {
      scene.remove(m);
      m.geometry.dispose();
    }
    shown = [];
    try {
      const s = settings();
      shown = [meshOf(clip(g, s), clipMaterial)];
      const ghost = presets.find((p) => p.id === state.tracker.preset)?.ghost;
      if (ghost === 'airpod' && state.tracker.kind === 'oval') shown.push(meshOf(airpodGhost(g, s), ghostMaterial));
      for (const m of shown) scene.add(m);
      if (!framed) frame();
      status.textContent = '';
    } catch {
      status.textContent = 'these measurements do not make a solid clip';
    }
  }

  function download(name: string, solid: any, ends: End[] = endsOf) {
    const s = settings();
    const header = 'bambi.wiki tracker clip, CC BY 4.0';
    const blob = new Blob([binaryStl(solid.getMesh(), header)], { type: 'model/stl' });
    const a = document.createElement('a');
    const describe = (end: End) =>
      `${state[end].kind}-` + kindOf(state[end].kind).measures.map((m) => `${m.key}${s[end].values[m.key]}`).join('-');
    a.href = URL.createObjectURL(blob);
    const gap = ends.length === 2 ? `-gap${s.reach}` : '';
    a.download = `bambi-${name}_${ends.map(describe).join('_')}_tol${s.fit.tolerance}-wall${s.fit.wall}${gap}.stl`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  form.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.dataset.kindChoice) {
      const end = b.closest<HTMLElement>('[data-end]')!.dataset.end as End;
      if (state[end].kind !== b.dataset.kindChoice) {
        state[end] = { preset: '', kind: b.dataset.kindChoice, values: { ...kindOf(b.dataset.kindChoice).defaults } };
        framed = false;
      }
    }
    if (b.dataset.export === 'clip') return download('tracker-clip', clip(g, settings()));
    if (b.dataset.export === 'tracker') return download('tracker-grip', trackerGrip(g, settings()).solid, ['tracker']);
    if (b.dataset.export === 'headphones') return download('headphone-grip', headphoneGrip(g, settings()).solid, ['headphones']);
    showForm();
    remember();
    rebuild();
  });
  form.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    if (!select.matches('[data-device]')) return;
    const p = presets.find((x) => x.id === select.value);
    if (!p) return; // custom: keep what is there
    state[p.end] = { preset: p.id, kind: p.kind, values: { ...p.values } };
    framed = false;
    showForm();
    remember();
    rebuild();
  });
  form.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches('[data-device]')) return;
    const n = Number(input.value);
    if (!input.name || !Number.isFinite(n) || input.value === '') return;
    if (input.name === 'tolerance' || input.name === 'wall' || input.name === 'reach') state[input.name] = n;
    else {
      const [end, key] = input.name.split('.') as [End, string];
      state[end].values[key] = n;
      if (state[end].preset) {
        state[end].preset = ''; // edited: no longer the device as listed
        showForm();
      }
    }
    remember();
    rebuild();
  });

  //  a field's hint on its section's one line, while the field has the pointer or the keyboard
  const hint = (e: Event) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('input[data-hint]');
    if (!input) return;
    const line = input.closest('section')?.querySelector<HTMLElement>('[data-hint-line]');
    if (line) line.textContent = e.type === 'focusout' || e.type === 'mouseout' ? '' : (input.dataset.hint ?? '');
  };
  for (const type of ['focusin', 'focusout', 'mouseover', 'mouseout']) form.addEventListener(type, hint);

  showForm();
  resize();
  (Module as any)({ locateFile: () => wasmUrl }).then((w: any) => {
    w.setup();
    g = { CrossSection: w.CrossSection, Manifold: w.Manifold };
    rebuild();
  });
</script>

<style>
  h1 {
    margin: 8px 0 16px;
  }
  .summary {
    margin-bottom: 24px;
  }
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 720px);
    gap: 40px;
    align-items: start;
  }
  .look {
    position: sticky;
    top: calc(var(--header) + 16px);
  }
  .form section {
    margin-bottom: 20px;
  }
  .form {
    padding-top: 6px;
  }
  .form h2 {
    margin-bottom: 10px;
  }
  .device {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .device select {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 15px;
    padding: 5px 6px;
    color: var(--text);
    background: var(--panel);
    border: var(--stroke-rule) solid var(--rule);
    border-radius: 0;
  }
  .segments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .segments button {
    font: inherit;
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    color: var(--text);
    background: none;
    border: 0;
    padding: 8px 6px;
    cursor: pointer;
  }
  .segments button:hover {
    background: var(--panel);
  }
  .segments button.chosen {
    background: var(--chosen);
    color: var(--text-inverse);
  }
  .ends {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
  }
  .kind[hidden] {
    display: none;
  }
  .kind {
    display: grid;
    gap: 12px;
    margin-top: 14px;
  }
  .figure {
    margin: 0;
    color: var(--text);
  }
  .figure :global(svg) {
    display: block;
    width: 100%;
    max-width: 280px;
    overflow: visible;
    height: auto;
    font-size: 15px;
    letter-spacing: 0.04em;
  }
  .figure :global(text) {
    fill: var(--label);
  }
  .values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 12px;
  }
  .values.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .value {
    display: grid;
    gap: 3px;
  }
  .field {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .field input {
    font: inherit;
    font-size: 16px;
    width: 100%;
    min-width: 0;
    padding: 4px 6px;
    background: var(--panel);
    color: var(--text);
    border: var(--stroke-rule) solid var(--rule);
    border-radius: 0;
  }
  .field input:focus {
    outline: none;
    border-color: var(--rule-strong);
  }
  .unit,
  .hint {
    color: var(--label);
    font-size: var(--size-small);
  }
  .hint[data-hint-line] {
    min-height: 1.5em;
    margin: 4px 0;
  }
  .export {
    display: grid;
    gap: 10px;
  }
  [data-end] .button {
    width: 100%;
  }
  .button {
    font: inherit;
    font-size: 14px;
    padding: 9px 10px;
    background: none;
    color: var(--text);
    border: var(--stroke-rule) solid var(--rule-strong);
    cursor: pointer;
  }
  .button:hover {
    background: var(--panel);
  }
  .button.main {
    background: var(--chosen);
    color: var(--text-inverse);
  }
  .export p {
    margin: 0;
  }
  .preview {
    position: relative;
    border: var(--stroke-rule) solid var(--rule);
    min-height: 320px;
  }
  .preview :global(canvas) {
    display: block;
    width: 100%;
    touch-action: none;
  }
  .status {
    position: absolute;
    margin: 12px;
    text-transform: none;
  }
  @media (max-width: 1100px) {
    .tool {
      grid-template-columns: 1fr;
    }
    .look {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .ends {
      grid-template-columns: 1fr;
    }
    .look {
      position: static;
    }
  }
</style>
