---
import Page from '../../layouts/Page.astro';
import Cards from '../../components/Cards.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tools = [
  {
    href: `${base}/tools/tracker-clip`,
    title: 'tracker clip',
    text: 'A printable clip that holds a head tracker, or an AirPod, on the headphones you listen on.',
    kind: 'printable',
  },
  {
    href: `${base}/tools/speakers`,
    title: 'speakers',
    text: 'Point a phone at your speakers and measure them where you listen, then export the layout for a decoder.',
    kind: 'with a phone',
  },
];
---

<Page title="tools" description="Small tools around working with bambi.">
  <h1>tools</h1>
  <p class="sub label">small things around working with bambi</p>
  <Cards items={tools} />
</Page>

<style>
  .sub {
    margin: 12px 0 var(--section);
  }
</style>
