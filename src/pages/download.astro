---
/*  The three builds, as the plugins' tabs: the visitor's system chosen, its download and its steps under it.
    Without script every system is listed one under another and every link still works; with it, the links
    point at the newest release, pre-releases included -- GitHub's `latest` skips a release marked as one. */
import Page from '../layouts/Page.astro';

const repo = 'https://github.com/Looderso/bambi';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = `${repo}/releases`;

interface System {
  id: 'macos' | 'windows' | 'linux';
  name: string;
  machines: string;
  folders: { vst3: string; clap: string };
  admin?: boolean;
  unsigned?: string;
  quarantine?: string;
}

const systems: System[] = [
  {
    id: 'macos',
    name: 'macOS',
    machines: 'apple silicon and intel',
    folders: { vst3: '~/Library/Audio/Plug-Ins/VST3/', clap: '~/Library/Audio/Plug-Ins/CLAP/' },
    unsigned: 'macOS blocks unsigned plugins that came from the internet, so remove the quarantine flag once, in Terminal:',
    quarantine:
      'xattr -dr com.apple.quarantine ~/Library/Audio/Plug-Ins/VST3/bambi*.vst3 ~/Library/Audio/Plug-Ins/CLAP/bambi*.clap',
  },
  {
    id: 'windows',
    name: 'Windows',
    machines: 'x64',
    folders: { vst3: 'C:\\Program Files\\Common Files\\VST3\\', clap: 'C:\\Program Files\\Common Files\\CLAP\\' },
    admin: true,
    unsigned: 'Windows may warn about them when you unpack the zip; the plugins themselves install and run normally.',
  },
  {
    id: 'linux',
    name: 'Linux',
    machines: 'x86-64',
    folders: { vst3: '~/.vst3/', clap: '~/.clap/' },
  },
];

const zip = (id: string) => `${releases}/latest/download/bambi-${id}.zip`;
---

<Page title="download" description="bambi for macOS, Windows and Linux: VST3 and CLAP.">
  <h1>download</h1>
  <p class="sub label">vst3 and clap · macos, windows and linux · free and open source</p>

  <div class="intro">
    <div class="prose">
      <p>
        bambi is in <strong>alpha</strong>: expect things to change between releases, and please{' '}
        <a href={`${repo}/issues/new?template=report.yml`}>report what breaks</a>. The builds are not signed yet,
        which on macOS and Windows takes one extra step. Which hosts bambi has been tried in, and what does not work
        yet, is on the <a href={`${base}/status`}>status</a> page.
      </p>
    </div>
    <a class="release" href={releases} data-release hidden>
      <span class="kind">newest release</span>
      <span class="name" data-release-name></span>
      <span class="what" data-release-what></span>
    </a>
  </div>

  <div class="picker" data-picker hidden>
    <div class="tabs" role="tablist">
      {
        systems.map((s) => (
          <button type="button" role="tab" data-choose={s.id}>
            {s.name}
          </button>
        ))
      }
    </div>
    <p class="mine label" data-mine></p>
  </div>

  <div class="systems">
    {
      systems.map((s) => (
        <section class="system" data-system={s.id}>
          <h2 class="title">{s.name}</h2>
          <div class="get">
            <a class="button" href={zip(s.id)} data-zip={`bambi-${s.id}.zip`}>
              download for {s.name}
            </a>
            <span class="label">{s.machines} · vst3 and clap</span>
          </div>
          <ol class="steps prose">
            <li>
              <span class="n">1</span>
              <div>
                <p>
                  Unpack the zip and copy the plugins into your plugin folders
                  {s.admin ? ' (this needs administrator rights)' : ''}:
                </p>
                <table>
                  <tbody>
                    <tr>
                      <td><code>VST3/*.vst3</code></td>
                      <td><code>{s.folders.vst3}</code></td>
                    </tr>
                    <tr>
                      <td><code>CLAP/*.clap</code></td>
                      <td><code>{s.folders.clap}</code></td>
                    </tr>
                  </tbody>
                </table>
                {s.id === 'macos' && <p class="fine">~/Library is hidden in Finder: choose Go › Go to Folder…, then type the path.</p>}
              </div>
            </li>
            {s.unsigned && (
              <li>
                <span class="n">2</span>
                <div>
                  <p>These alpha builds are not signed. {s.unsigned}</p>
                  {s.quarantine && <pre><code>{s.quarantine}</code></pre>}
                </div>
              </li>
            )}
            <li>
              <span class="n">{s.unsigned ? 3 : 2}</span>
              <div>
                <p>Restart your host and let it rescan its plugins.</p>
              </div>
            </li>
          </ol>
        </section>
      ))
    }
  </div>

  <section class="prose every">
    <h2>every release</h2>
    <p>
      Every build is on the <a href={releases}>releases page</a>, with its notes and the complete source of that
      release. The plugins are licensed under the GNU AGPLv3 and bambi's own code under the GPLv3; the notices of
      every third-party component are in the zip.
    </p>
  </section>
</Page>

<script>
  /*  The systems as tabs, the visitor's chosen. Then the newest release, pre-releases included: GitHub's
      `latest` skips a pre-release, so the static links are only the fallback. */
  const picker = document.querySelector<HTMLElement>('[data-picker]')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-system]')];
  const tabs = [...picker.querySelectorAll<HTMLButtonElement>('[data-choose]')];
  const agent = ((navigator as any).userAgentData?.platform || navigator.userAgent || '').toLowerCase();
  const mine = /mac/.test(agent) ? 'macos' : /win/.test(agent) ? 'windows' : /linux|x11/.test(agent) ? 'linux' : null;
  const choose = (id: string) => {
    for (const s of sections) s.hidden = s.dataset.system !== id;
    for (const t of tabs) {
      const on = t.dataset.choose === id;
      t.classList.toggle('chosen', on);
      t.setAttribute('aria-selected', String(on));
    }
  };
  document.documentElement.classList.add('picking');
  picker.hidden = false;
  if (mine) picker.querySelector<HTMLElement>('[data-mine]')!.textContent = `your system: ${tabs.find((t) => t.dataset.choose === mine)?.textContent?.trim()}`;
  for (const t of tabs) t.addEventListener('click', () => choose(t.dataset.choose!));
  choose(mine ?? 'macos');

  fetch('https://api.github.com/repos/Looderso/bambi/releases?per_page=10')
    .then((r) => (r.ok ? r.json() : null))
    .then((list: any[] | null) => {
      if (!list) return; // the API refused, most likely its rate limit: the static links stand
      const release = list.find((r) => !r.draft);
      const card = document.querySelector<HTMLAnchorElement>('[data-release]')!;
      card.hidden = false;
      if (!release) {
        card.querySelector('[data-release-name]')!.textContent = 'none yet';
        card.querySelector('[data-release-what]')!.textContent = 'the links work once the first alpha is out';
        return;
      }
      card.href = release.html_url;
      card.querySelector('[data-release-name]')!.textContent = release.name || release.tag_name;
      card.querySelector('[data-release-what]')!.textContent = release.prerelease ? 'pre-release · its notes →' : 'its notes →';
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-zip]')) {
        const asset = release.assets?.find((a: any) => a.name === link.dataset.zip);
        if (asset) link.href = asset.browser_download_url;
      }
    })
    .catch(() => {});
</script>

<style>
  .sub {
    margin: 12px 0 var(--section);
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
    gap: 32px;
    align-items: start;
    margin-bottom: 48px;
  }
  .intro p {
    margin: 0;
  }
  /*  the newest release, as a tile */
  .release {
    display: grid;
    gap: 4px;
    padding: 12px 14px 14px;
    border: var(--stroke-rule) solid var(--rule);
    color: var(--text);
  }
  .release:hover {
    background: var(--panel);
    border-color: var(--rule-strong);
    text-decoration: none;
  }
  .release .kind {
    font-size: var(--size-small);
    letter-spacing: var(--tracking-label);
    color: var(--label);
  }
  .release .name {
    font-size: 18px;
  }
  .release .what {
    font-size: 14px;
    color: var(--label);
  }

  /*  the systems as tabs: the chosen one the black block, standing on the rule */
  .picker {
    margin-bottom: 28px;
  }
  .tabs {
    display: flex;
    gap: 2px;
    border-bottom: var(--stroke-rule) solid var(--rule-strong);
  }
  .tabs button {
    font: inherit;
    font-size: 15px;
    color: var(--text);
    background: none;
    border: 0;
    padding: 10px 18px;
    cursor: pointer;
  }
  .tabs button:hover {
    background: var(--panel);
  }
  .tabs button.chosen {
    background: var(--chosen);
    color: var(--text-inverse);
  }
  .mine {
    margin: 8px 0 0;
    text-transform: none;
  }
  :global(.picking) .system .title {
    display: none;
  }
  .system + .system {
    margin-top: 48px;
  }
  :global(.picking) .system + .system {
    margin-top: 0;
  }
  .system .title {
    text-transform: none;
  }

  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-bottom: 28px;
  }
  .button {
    display: inline-block;
    padding: 11px 20px;
    background: var(--chosen);
    color: var(--text-inverse);
  }
  .button:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*  the steps as numbered rows */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
    border-top: var(--stroke-rule) solid var(--rule-strong);
  }
  .steps li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    margin: 0;
    border-bottom: var(--stroke-rule) solid var(--sand-light);
  }
  .steps .n {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: var(--stroke-rule) solid var(--rule-strong);
    font-size: 13px;
  }
  .steps p {
    margin: 3px 0 8px;
  }
  .steps table {
    margin: 4px 0 6px;
  }
  .steps pre {
    margin: 8px 0 0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .every {
    margin-top: var(--section);
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tabs button {
      flex: 1;
      padding-inline: 8px;
    }
  }
</style>
