---
/*  Download, as a page of screens: the visitor's system with its download and steps; what the zip holds and
    the host. The systems are tabs with the visitor's chosen. Without script every system is
    listed one under another and every link still works; with it, the links point at the newest release,
    pre-releases included -- GitHub's `latest` skips a release marked as one. */
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import Cards from '../components/Cards.astro';
import { discord } from '../lib/links';

const repo = 'https://github.com/Looderso/bambi';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = `${repo}/releases`;

interface System {
  id: 'macos' | 'windows' | 'linux';
  name: string;
  machines: string;
  folders: { vst3: string; clap: string };
  admin?: boolean;
  installer?: boolean; // a signed installer beside the zip, which is the way in; the zip is for copying by hand
  note?: string;
}
const systems: System[] = [
  {
    id: 'macos',
    name: 'macOS',
    machines: 'macos 14 and later · apple silicon and intel',
    folders: { vst3: '~/Library/Audio/Plug-Ins/VST3/', clap: '~/Library/Audio/Plug-Ins/CLAP/' },
    installer: true,
    note: 'The installer and the plugins are signed and notarised by Apple, so macOS opens them without asking. Keep one copy of each plugin: one in ~/Library and one in /Library show up twice in your DAW.',
  },
  {
    id: 'windows',
    name: 'Windows',
    machines: 'x64',
    folders: { vst3: 'C:\\Program Files\\Common Files\\VST3\\', clap: 'C:\\Program Files\\Common Files\\CLAP\\' },
    admin: true,
    note: 'The Windows builds are not signed: Windows may warn when you unpack the zip, and the plugins install and run as they are.',
  },
  {
    id: 'linux',
    name: 'Linux',
    machines: 'x86-64',
    folders: { vst3: '~/.vst3/', clap: '~/.clap/' },
  },
];
const asset = (name: string) => `${releases}/latest/download/${name}`;

const plugins = (await getCollection('plugins')).sort((a, b) => a.data.order - b.data.order);
const tiles = plugins.map((p) => ({
  href: `${base}/plugins/${p.id}`,
  title: p.data.name,
  text: p.data.summary,
  colour: p.data.colour,
  mark: `${base}/marks/${p.id}.svg`,
}));
---

<Page title="download" description="bambi for macOS, Windows and Linux: VST3 and CLAP." wide>
  <div class="download snap">
    <section class="screen">
      <h1>download</h1>
      <p class="sub label">vst3 and clap · macos, windows and linux · free and open source</p>
      <p class="about">
        bambi is in open beta: it works, and it will still change between releases. Please{' '}
        <a href={`${repo}/issues/new?template=report.yml`}>report what breaks</a> or ask on <a href={discord}>Discord</a>;
        where it has been tried is on{' '}
        <a href={`${base}/status`}>status</a>.
      </p>
      <div class="choose">
        <div class="picker" data-picker hidden>
          <div class="tabs" role="tablist">
            {
              systems.map((s) => (
                <button type="button" role="tab" data-choose={s.id}>
                  {s.name}
                </button>
              ))
            }
          </div>
        </div>
        <a class="label release" href={releases} data-release>every release, its notes and its source →</a>
      </div>

      <div class="systems">
        {
          systems.map((s) => (
            <section class="system" data-system={s.id}>
              <h2 class="title">{s.name}</h2>
              {s.installer ? (
                <>
                  <div class="get">
                    <a class="button" href={asset(`bambi-${s.id}.pkg`)} data-zip={`bambi-${s.id}.pkg`}>
                      installer for {s.name}
                    </a>
                    <a class="button quiet" href={asset(`bambi-${s.id}.zip`)} data-zip={`bambi-${s.id}.zip`}>
                      or the zip, to copy by hand
                    </a>
                    <span class="label">{s.machines} · vst3 and clap</span>
                  </div>
                  <ol class="steps prose">
                    <li>
                      <div>
                        <p>
                          Open the installer and choose what it puts on this Mac: the plugins, for every user, and, if
                          you play with Ableton Live, the live host.
                        </p>
                      </div>
                    </li>
                    <li>
                      <div>
                        <p>Restart your DAW and let it rescan its plugins.</p>
                      </div>
                    </li>
                  </ol>
                  <p class="fine">
                    The zip holds the plugins alone: copy <code>VST3/*.vst3</code> to <code>{s.folders.vst3}</code> and{' '}
                    <code>CLAP/*.clap</code> to <code>{s.folders.clap}</code>. ~/Library is hidden in Finder: choose Go › Go
                    to Folder…, then type the path.
                  </p>
                </>
              ) : (
                <>
                  <div class="get">
                    <a class="button" href={asset(`bambi-${s.id}.zip`)} data-zip={`bambi-${s.id}.zip`}>
                      download for {s.name}
                    </a>
                    <span class="label">{s.machines} · vst3 and clap</span>
                  </div>
                  <ol class="steps prose">
                    <li>
                      <div>
                        <p>
                          Unpack the zip and copy the plugins into your plugin folders
                          {s.admin ? ' (this needs administrator rights)' : ''}:
                        </p>
                        <table>
                          <tbody>
                            <tr>
                              <td><code>VST3/*.vst3</code></td>
                              <td><code>{s.folders.vst3}</code></td>
                            </tr>
                            <tr>
                              <td><code>CLAP/*.clap</code></td>
                              <td><code>{s.folders.clap}</code></td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </li>
                    <li>
                      <div>
                        <p>Restart your DAW and let it rescan its plugins.</p>
                      </div>
                    </li>
                  </ol>
                </>
              )}
              {s.note && <p class="fine">{s.note}</p>}
            </section>
          ))
        }
      </div>
    </section>

    <section class="screen" aria-labelledby="zip">
      <h2 id="zip">what you get</h2>
      <Cards items={tiles} pairs />
      <p class="about">
          Every build is on GitHub, with its notes and the complete source of that release. The plugins are licensed under the GNU AGPLv3 and bambi's own code under the GPLv3; the notices of
          every third-party component come with every download.
      </p>
    </section>

    <section class="screen" aria-labelledby="host">
      <h2 id="host">the host</h2>
      <div class="host">
        <img class="mark" src={`${base}/marks/host.svg`} alt="" width="72" height="72" />
        <div>
          <p class="about">
            The host runs bambi's plugins beside Ableton Live, on macOS. It comes with its virtual audio driver, which
            carries Live's tracks to it, and a Max for Live device, which needs Live Suite, or Live Standard with Max for
            Live.
          </p>
          <ol class="steps across">
            <li>
              <span class="title">install it</span>
              <span class="text">In the macOS installer, choose the live host as well as the plugins.</span>
            </li>
            <li>
              <span class="title">open it once</span>
              <span class="text">Open bambi live host from Applications: it puts the Max for Live device into Live's browser. Allow the microphone when macOS asks: it is how the host hears Live.</span>
            </li>
            <li>
              <span class="title">set up Live</span>
              <span class="text">Choose bambi as Live's audio device, and put the bambi device, under Max for Live › Max Audio Effect, on the Main track.</span>
            </li>
          </ol>
          <p class="fine">
            What it does is on <a href={`${base}/host`}>its page</a>, and how to set it up in
            <a href={`${base}/tutorial/host`}>its tutorial</a>. To remove everything the installer put on the Mac, run
            <code>sudo "/Library/Application Support/bambi/uninstall.sh"</code> in Terminal.
          </p>
        </div>
      </div>
    </section>
  </div>
</Page>

<script>
  /*  The systems as tabs, the visitor's chosen. Then the newest release, pre-releases included: GitHub's
      `latest` skips a pre-release, so the static links are only the fallback. */
  const picker = document.querySelector<HTMLElement>('[data-picker]')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-system]')];
  const tabs = [...picker.querySelectorAll<HTMLButtonElement>('[data-choose]')];
  const agent = ((navigator as any).userAgentData?.platform || navigator.userAgent || '').toLowerCase();
  const mine = /mac/.test(agent) ? 'macos' : /win/.test(agent) ? 'windows' : /linux|x11/.test(agent) ? 'linux' : null;
  const choose = (id: string) => {
    for (const s of sections) s.hidden = s.dataset.system !== id;
    for (const t of tabs) {
      const on = t.dataset.choose === id;
      t.classList.toggle('chosen', on);
      t.setAttribute('aria-selected', String(on));
    }
  };
  document.documentElement.classList.add('picking');
  picker.hidden = false;
  for (const t of tabs) t.addEventListener('click', () => choose(t.dataset.choose!));
  choose(mine ?? 'macos');

  const link = document.querySelector<HTMLAnchorElement>('[data-release]')!;
  fetch('https://api.github.com/repos/Looderso/bambi/releases?per_page=10')
    .then((r) => (r.ok ? r.json() : null))
    .then((list: any[] | null) => {
      if (!list) return; // the API refused, most likely its rate limit: the static links stand
      const release = list.find((r) => !r.draft);
      if (!release) return void (link.textContent = 'no release yet: the links work once the first is out');
      link.href = release.html_url;
      link.textContent = `newest: ${release.name || release.tag_name}${release.prerelease ? ' · pre-release' : ''} · its notes →`;
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-zip]')) {
        const asset = release.assets?.find((a: any) => a.name === link.dataset.zip);
        if (asset) link.href = asset.browser_download_url;
      }
    })
    .catch(() => {});
</script>

<style>
  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  h2 {
    margin: 0;
  }
  .sub {
    margin: 0; /* the screen's gap spaces it */
  }
  .about {
    max-width: 52ch;
    margin: 0;
  }
  .fine {
    margin: 0;
  }

  /*  the systems as tabs, and the newest release at the row's far end, both standing on one rule */
  .choose {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 8px var(--gap);
    border-bottom: var(--stroke-rule) solid var(--rule-strong);
  }
  .release {
    padding-bottom: 10px;
    text-transform: none;
  }
  /*  the systems as tabs: the chosen one the black block, standing on the rule */
  .tabs {
    display: flex;
    gap: 2px;
  }
  .tabs button {
    font: inherit;
    font-size: 15px;
    color: var(--text);
    background: none;
    border: 0;
    padding: 10px 18px;
    cursor: pointer;
  }
  .tabs button:hover {
    background: var(--panel);
  }
  .tabs button.chosen {
    background: var(--chosen);
    color: var(--text-inverse);
  }
  :global(.picking) .system .title {
    display: none;
  }
  .system {
    display: grid;
    gap: calc(var(--gap) / 2);
    max-width: 760px; /* the steps' code is read whole, wider than prose */
  }
  .system[hidden] {
    display: none;
  }
  .system + .system {
    margin-top: var(--section);
  }
  :global(.picking) .system + .system {
    margin-top: 0;
  }
  .system .title {
    text-transform: none;
  }
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .steps p {
    margin: 3px 0 8px;
  }
  .steps table {
    margin: 4px 0 6px;
  }
  .steps pre {
    margin: 4px 0 0;
    white-space: pre-wrap;
    word-break: break-all;
  }


  /*  The host: its mark beside what it is and its three parts. */
  .host {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .host > div {
    display: grid;
    gap: var(--gap);
    max-width: 900px;
  }

  @media (max-width: 760px) {
    /*  On a phone the steps are set smaller, so a system's download and steps still fit one screen. */
    .steps {
      font-size: var(--size-card-text);
    }
    .steps > li {
      gap: 12px;
      padding: 10px 0;
    }
    .steps :global(code),
    .steps :global(pre) {
      font-size: var(--size-small);
    }
    .steps pre {
      padding-block: 10px;
    }
    .steps .fine,
    .system > .fine,
    .host .fine {
      display: none; /* how to copy and what is signed: of use at the computer, not on the phone itself */
    }
    .tabs button {
      flex: 1;
      padding-inline: 8px;
    }
    .host {
      grid-template-columns: 1fr;
    }
    .host .mark {
      width: 56px;
      height: 56px;
    }
  }
</style>
