---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Cards from '../../components/Cards.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const plugins = (await getCollection('plugins')).sort((a, b) => a.data.order - b.data.order);
const items = plugins.map((p) => ({
  href: `${base}/plugins/${p.id}`,
  title: p.data.name,
  text: p.data.summary,
  kind: 'plugin',
  colour: p.data.colour,
}));
---

<Page title="plugins" description="What each bambi plugin does.">
  <h1>plugins</h1>
  <p class="sub label">space you shape by ear, moved by what the music plays</p>
  <Cards items={items} />
</Page>

<style>
  .sub {
    margin: 12px 0 var(--section);
  }
</style>
