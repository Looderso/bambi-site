---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Cards from '../../components/Cards.astro';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}

const { plugin } = Astro.props;
const { Content } = await render(plugin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Page title={plugin.data.name} description={plugin.data.summary} identity={plugin.data.colour}>
  <p class="label"><a href={`${base}/plugins`}>plugins</a></p>
  <h1>{plugin.data.name}</h1>
  <p class="lede summary">{plugin.data.summary}</p>
  <div class="prose">
    <Content />
  </div>

  <section class="tutorials">
    <h2>tutorials</h2>
    <Cards
      items={[
        { href: `${base}/tutorial/${plugin.id}`, title: plugin.data.name, text: `How to use ${plugin.data.name}, step by step.`, kind: 'this plugin', colour: plugin.data.colour },
        { href: `${base}/tutorial/the-window`, title: 'the window', text: 'The scene, the matrix, presets and the link every plugin shares.', kind: 'every plugin' },
      ]}
      style="row"
    />
  </section>
</Page>

<style>
  h1 {
    margin: 8px 0 16px;
  }
  .summary {
    margin-bottom: var(--section);
  }
  .tutorials {
    margin-top: var(--section);
  }
</style>
