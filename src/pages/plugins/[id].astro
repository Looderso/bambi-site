---
/*  A plugin's page: a product page from its parts when it has them, otherwise its text alone. Both end
    with its tutorial and the one for the window every plugin shares. */
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Cards from '../../components/Cards.astro';
import ProductPage from '../../components/ProductPage.astro';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}

const { plugin } = Astro.props;
const { Content } = await render(plugin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { name, summary, colour, intro, parts } = plugin.data;
const tutorials = [
  { href: `${base}/tutorial/${plugin.id}`, title: name, text: `How to use ${name}, step by step.`, kind: 'this plugin', colour },
  { href: `${base}/tutorial/the-window`, title: 'the window', text: 'The scene, the matrix, presets and the link every plugin shares.', kind: 'every plugin' },
];
---

<Page title={name} description={summary} identity={colour} wide={!!parts}>
  {
    parts ? (
      <ProductPage
        name={name}
        mark={`${base}/marks/${plugin.id}.svg`}
        summary={summary}
        section={{ href: `${base}/plugins`, name: 'plugins' }}
        shots={`${base}/product/${plugin.id}`}
        intro={intro}
        parts={parts}
        tutorials={tutorials}
      >
        <div class="prose after">
          <Content />
        </div>
      </ProductPage>
    ) : (
      <>
        <p class="label"><a href={`${base}/plugins`}>plugins</a></p>
        <h1>{name}</h1>
        <p class="lede summary">{summary}</p>
        <div class="prose">
          <Content />
        </div>
        <section class="tutorials">
          <h2>tutorials</h2>
          <Cards items={tutorials} style="row" />
        </section>
      </>
    )
  }
</Page>

<style>
  h1 {
    margin: 8px 0 16px;
  }
  .summary {
    margin-bottom: var(--section);
  }
  .tutorials {
    margin-top: var(--section);
  }
  .after {
    margin-top: var(--section);
    border-top: var(--stroke-rule) solid var(--rule-strong);
    padding-top: 24px;
  }
</style>
