---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="wrap row">
    <span class="notice label">© 2026 the bambi contributors · gpl-3.0-or-later, plugins agplv3</span>
    <span class="links">
      <a class="label" href="https://github.com/Looderso/bambi">source</a>
      <a class="label" href={`${base}/about`}>about</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--stroke-identity) solid var(--identity);
    margin-top: var(--section);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 4px var(--gap);
    flex-wrap: wrap;
    min-height: var(--header);
    padding-block: 8px;
  }
  .links {
    display: flex;
    gap: 18px;
  }
  .links a:hover {
    color: var(--text);
  }
</style>
