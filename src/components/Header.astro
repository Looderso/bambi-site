---
/*  The wordmark, then the sections, on one row that stays at the top of the screen. The open section is a
    black block standing on the rule, as an open tab is in the plugins. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '') || '/';

const sections = [
  { href: '/plugins', name: 'plugins' },
  { href: '/tutorial', name: 'tutorial' },
  { href: '/tools', name: 'tools' },
  { href: '/foundations', name: 'foundations' },
  { href: '/contribute', name: 'contribute' },
  { href: '/download', name: 'download' },
  { href: '/about', name: 'about' },
];
const open = (href: string) => here === href || here.startsWith(href + '/');
---

<header class="header">
  <div class="wrap bar">
    <a class="wordmark" href={`${base}/`} aria-label="bambi, home">βambi</a>
    <nav aria-label="sections">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`${base}${s.href}`} class:list={{ open: open(s.href) }} aria-current={open(s.href) ? 'page' : undefined}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  /*  On a narrow screen the sections scroll sideways: bring the open one into view, without moving the page. */
  const nav = document.querySelector<HTMLElement>('.header nav');
  const open = nav?.querySelector<HTMLElement>('a.open');
  if (nav && open && open.offsetLeft + open.offsetWidth > nav.clientWidth)
    nav.scrollLeft = open.offsetLeft - (nav.clientWidth - open.offsetWidth) / 2;
</script>

<style>
  /*  One row, on one centre line, that stays at the top: the open section is a black block the full
      height of the bar, standing on the rule. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ground);
    border-bottom: var(--stroke-identity) solid var(--identity);
  }
  .bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--gap);
    height: var(--header);
  }
  .wordmark {
    display: flex;
    align-items: center;
    flex: none;
    color: var(--text);
    font-size: 17px;
    letter-spacing: var(--tracking-wordmark);
  }
  .wordmark:hover {
    text-decoration: none;
  }
  nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: flex;
    height: 100%;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    white-space: nowrap;
    color: var(--text);
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
  }
  nav a:hover {
    text-decoration: none;
    background: var(--panel);
  }
  nav a.open {
    background: var(--chosen);
    color: var(--text-inverse);
  }
</style>
